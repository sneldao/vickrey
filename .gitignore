# MP4, the generated voice/music takes and the capture assets do not.
*.mp4
*.mov
*.m4v
*.webm
docs/film/audio/
docs/film/assets/

# Vercel/Next local project metadata
.vercel/

# Local node configs with real credentials stay out of git.
services/zanchor/docker/zcash.conf
services/zanchor/data/
