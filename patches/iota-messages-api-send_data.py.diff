+def fanout_ledger(block_id, tag, message, hornet_status):
+    """Best-effort. A ledger outage must not fail the Tangle upload."""
+    body = {
+        "blockId": block_id,
+        "tag": tag,
+        "message": message,
+        "hornetStatus": hornet_status,
+    }
+    try:
+        ledger_response = requests.post(LEDGER_URL, json=body, timeout=5)
+        print("ledger fan-out", LEDGER_URL, ledger_response.status_code, ledger_response.text)
+    except Exception as exc:
+        print("ledger fan-out failed:", exc)
