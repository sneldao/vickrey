# zcashd v6.20.0 from source — no published binary images exist.
# Two stages: the build stage is heavy (and slow); the runtime image
# carries only the two binaries and their shared libraries, so it stays
# push-sized for the Fly node.
#
#   docker build -f Dockerfile.zcashd -t <registry>/vickrey-zcashd:v6.20.0 .

FROM ubuntu:24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential git curl ca-certificates unzip ccache file wget xz-utils procps \
      autoconf automake libtool pkg-config cmake bsdextrautils \
      libssl-dev libevent-dev libgomp1 \
      libboost-all-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain none
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build/zcash
RUN git clone --recursive --branch v6.20.0 --depth 1 https://github.com/zcash/zcash .
# No `| tail`: a piped exit code would swallow configure failures.
RUN ./zcutil/build.sh -j"$(nproc)"

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
# Proving parameters are embedded in the binary since 5.x; runtime needs
# only the shared libraries. noble's libevent is 2.1-7t64.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libssl3t64 libevent-core-2.1-7t64 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /build/zcash/src/zcashd /build/zcash/src/zcash-cli /usr/local/bin/

VOLUME /data
ENTRYPOINT ["/usr/local/bin/zcashd"]
CMD ["-datadir=/data", "-confdir=/data"]
